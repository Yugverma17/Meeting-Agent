# Copy to .env and fill in. Never commit .env.

# --- LLM providers (both have perpetual free tiers, no card required) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional: tracing (LangSmith, free tier ~5k traces/month) ---
# https://smith.langchain.com/settings
# With no key set, tracing is inert: nothing is uploaded and the decorators
# return the undecorated function.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=quorum
LANGSMITH_TRACING=true

# --- Optional: reality-verification layer ---
# Fine-grained PAT, read-only on repo contents + issues
GITHUB_TOKEN=
# Desktop OAuth client for Google Calendar. Scope requested is calendar.events
# only - read/write on events, and nothing else on the account.
GOOGLE_CLIENT_SECRETS_FILE=credentials.json

# --- Deadlines in your calendar ---
# "primary" is your main calendar. A dedicated secondary calendar is worth
# creating: it can be toggled off in one click without losing the events.
QUORUM_CALENDAR_ID=primary
# Lead times for deadline reminders, in days before the due date.
QUORUM_REMINDER_DAYS=3,1
# Local hour the reminders fire. All-day events start at midnight, so without
# this the popup arrives at 00:00.
QUORUM_REMINDER_HOUR=9

# --- Behaviour ---
# Never let the agent send anything without human approval. Keep this true.
QUORUM_REQUIRE_APPROVAL=true
# Cache LLM calls to disk so eval re-runs cost zero quota.
QUORUM_CACHE_ENABLED=true
QUORUM_LOG_LEVEL=INFO
