# Copy to .env and fill in. Never commit .env.

# --- LLM providers (both have perpetual free tiers, no card required) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional: tracing (Langfuse Cloud free Hobby tier) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Optional: reality-verification layer (added in phase 6) ---
# Fine-grained PAT, read-only on repo contents + issues
GITHUB_TOKEN=
# Google OAuth client for Gmail/Calendar (readonly + compose scopes)
GOOGLE_CLIENT_SECRETS_FILE=credentials.json

# --- Behaviour ---
# Never let the agent send anything without human approval. Keep this true.
QUORUM_REQUIRE_APPROVAL=true
# Cache LLM calls to disk so eval re-runs cost zero quota.
QUORUM_CACHE_ENABLED=true
QUORUM_LOG_LEVEL=INFO
